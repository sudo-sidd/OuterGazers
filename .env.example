# ==============================================================================
# OUTERGAZERS STUDIO — ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# For GitHub Pages deployment, add these under:
# Repository Settings > Secrets and variables > Actions > Variables (or Secrets)
# ==============================================================================

# Google Apps Script Web App URL
# Receives registrations, contact inquiries, and payment screenshots
# Deploy google_apps_script.js in Google Sheets to get this URL
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id/exec

# Community Links
NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/FgccrKjdgVoEZcklvGzbuS?s=cl&p=a&iam=2

# UPI Payment Details
NEXT_PUBLIC_UPI_ID=outergazers@oksbi
NEXT_PUBLIC_UPI_PAYEE_NAME=OuterGazers Studio

# Contact Comms
NEXT_PUBLIC_CONTACT_EMAIL=connect@outergazer.in
NEXT_PUBLIC_FORMSUBMIT_URL=https://formsubmit.co/ajax/connect@outergazer.in

# (Optional) Payment Gateway ID if Razorpay integration is used
NEXT_PUBLIC_RAZORPAY_KEY_ID=
